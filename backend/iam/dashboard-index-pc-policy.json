{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PcDashboardIndexPartition",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:677513020767:table/apollo-dashboard-index",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "pc"
          ]
        }
      }
    }
  ]
}
