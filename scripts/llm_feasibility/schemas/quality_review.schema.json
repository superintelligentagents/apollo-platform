{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo.internal/schemas/task-quality-review-v4.json",
  "title": "Apollo task quality and step alignment review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "overall_verdict",
    "confidence",
    "reviewed_at_utc",
    "summary",
    "task_coherence",
    "rubric_assessments"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "apollo-task-quality-review-v4"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "overall_verdict": {"type": "string", "enum": ["PASS", "FAIL", "NEEDS_HUMAN_REVIEW"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 360},
    "task_coherence": {"$ref": "#/$defs/axis"},
    "rubric_assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "verdict", "summary", "issues"],
        "properties": {
          "rubric_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "verdict": {"type": "string", "enum": ["PASS", "FAIL", "NEEDS_HUMAN_REVIEW"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 360},
          "issues": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 360}}
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "summary", "concerns"],
      "properties": {
        "verdict": {"type": "string", "enum": ["PASS", "FAIL", "NEEDS_HUMAN_REVIEW"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 360},
        "concerns": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 360}}
      }
    }
  }
}
