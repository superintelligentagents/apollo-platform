{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo.internal/schemas/llm-browser-review-v3.json",
  "title": "Read-only browser escalation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "rubric_id",
    "verdict",
    "confidence",
    "tested_at_utc",
    "summary",
    "evidence",
    "access_constraints",
    "blockers",
    "safety_notes",
    "rubric_feedback",
    "limitation_kind",
    "task_blocker"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "apollo-browser-feasibility-v3"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "rubric_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "verdict": {"type": "string", "enum": ["POSSIBLE", "SHORTFALL", "IMPOSSIBLE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tested_at_utc": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 360},
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "observed_at_utc", "actions", "observations", "side_effects"],
        "properties": {
          "url": {"type": "string", "pattern": "^https?://", "maxLength": 4000},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "observed_at_utc": {"type": "string", "format": "date-time"},
          "actions": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 360}
          },
          "observations": {"type": "string", "minLength": 1, "maxLength": 3000},
          "side_effects": {"type": "string", "const": "NONE"}
        }
      }
    },
    "access_constraints": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 360}
    },
    "blockers": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 360}
    },
    "safety_notes": {"type": "string", "maxLength": 3000},
    "rubric_feedback": {"type": ["string", "null"], "maxLength": 360},
    "limitation_kind": {"type": "string", "enum": ["NONE", "CHECKER_TOOL", "ACCESS", "TASK_DEFECT"]},
    "task_blocker": {"type": "boolean"}
  }
}
