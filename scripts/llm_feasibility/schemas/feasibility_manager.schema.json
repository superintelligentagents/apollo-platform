{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo.internal/schemas/llm-feasibility-manager-core-v4.json",
  "title": "Feasibility-only manager synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "disposition",
    "confidence",
    "reviewed_at_utc",
    "summary",
    "rubric_assessments",
    "cross_rubric_conflicts",
    "task_level_risks",
    "task_feedback"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "apollo-feasibility-manager-core-v4"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "disposition": {"type": "string", "enum": ["FEASIBLE", "NOT_FEASIBLE", "NEEDS_HUMAN_REVIEW"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 360},
    "rubric_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "accepted_worker_verdict", "manager_note"],
        "properties": {
          "rubric_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "accepted_worker_verdict": {"type": "string", "enum": ["POSSIBLE", "SHORTFALL", "IMPOSSIBLE", "WORKER_ERROR"]},
          "manager_note": {"type": "string", "minLength": 1, "maxLength": 360}
        }
      }
    },
    "cross_rubric_conflicts": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 360}
    },
    "task_level_risks": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 360}
    },
    "task_feedback": {"type": ["string", "null"], "maxLength": 360}
  }
}
