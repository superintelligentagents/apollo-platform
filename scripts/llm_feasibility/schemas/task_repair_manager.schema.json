{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo.internal/schemas/task-repair-manager-v1.json",
  "title": "Apollo advisory whole-task repair manager",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "summary",
    "task_prompt_edit_operations",
    "unresolved_rubric_ids",
    "cross_rubric_notes",
    "preserves_task_flow"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "apollo-task-repair-manager-v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
    "task_prompt_edit_operations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "old_text", "new_text"],
        "properties": {
          "operation": {"type": "string", "enum": ["REPLACE", "DELETE", "APPEND"]},
          "old_text": {"type": ["string", "null"], "maxLength": 8000},
          "new_text": {"type": "string", "maxLength": 8000}
        }
      }
    },
    "unresolved_rubric_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "cross_rubric_notes": {
      "type": "array",
      "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "preserves_task_flow": {"type": "boolean"}
  }
}
