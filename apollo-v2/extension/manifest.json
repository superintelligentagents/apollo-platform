{
  "manifest_version": 3,
  "name": "Apollo History Helper",
  "version": "1.0.0",
  "description": "Reads your Chrome history for the Apollo research study, with your permission. Everything stays on your device until you submit.",
  "key": "",
  "permissions": [
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://apollo-v2-site.vercel.app/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}