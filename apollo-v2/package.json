{
  "name": "apollo-v2-workspace",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "shared",
    "tauri",
    "web"
  ],
  "scripts": {
    "test": "npm run test -w shared",
    "typecheck": "npm run typecheck -w shared",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "dev:tauri": "npm run tauri -w tauri -- dev",
    "build:tauri": "npm run tauri -w tauri -- build"
  }
}
